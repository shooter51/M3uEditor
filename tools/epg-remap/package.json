{
  "name": "epg-remap",
  "version": "0.1.0",
  "description": "Rewrite public XMLTV EPG channel ids to match an IPTV playlist's tvg-ids, for TiviMate",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "epg-remap": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "serve": "node src/cli.js --serve",
    "dry-run": "node src/cli.js --dry-run",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "vitest": "^5.0.1"
  }
}
